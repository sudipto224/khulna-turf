# ─────────────────────────────────────────────────────────────
# Khulna Turf — env vars (.env.example)
# এই ফাইলটা কপি করে .env.local বানাও:  cp .env.example .env.local
# Vercel-এ deploy-এর সময় এখন কিছুই বসাতে হবে না (সব optional) —
# সাইট demo mode-এ চলবে। পরে যা লাগবে তা নিচে লেখা আছে।
# ⚠️ আসল keys কখনও কোডে/চ্যাটে দেবে না — শুধু .env.local বা
# Vercel Dashboard → Settings → Environment Variables-এ বসাবে।
# ─────────────────────────────────────────────────────────────

# --- এখন লাগবে না (পরে Supabase চালু করলে) ---
# supabase.com → প্রজেক্ট → Settings → API থেকে নেবে
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# শুধু সার্ভার থেকে admin কাজের জন্য (কখনও NEXT_PUBLIC_ করবে না)
SUPABASE_SERVICE_ROLE_KEY=

# --- এখন লাগবে না (পরে আসল পেমেন্ট চালু করলে) ---
# SSLCommerz sandbox/live store থেকে নেবে (টাকা ক্লায়েন্টের অ্যাকাউন্টে যাবে)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# টেস্টের সময় true, live-এ যাওয়ার সময় false
SSLCOMMERZ_SANDBOX=true

# --- Optional: সাইটের আসল ঠিকানা (Vercel deploy-এর পর) ---
# যেমন: https://khulna-turf.vercel.app — SEO/sitemap/pেমেন্ট callback-এর জন্য
NEXT_PUBLIC_SITE_URL=
